<Window x:Class="palacsinta.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:palacsinta"
        mc:Ignorable="d"
        Title="Palacsinta" Height="476" Width="800">
    <Grid Margin="0,0,0,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="19*"/>
            <RowDefinition Height="415*"/>
        </Grid.RowDefinitions>
        <Label Content="2. feladat" HorizontalAlignment="Left" Margin="50,18,0,0" VerticalAlignment="Top" FontSize="16" Grid.RowSpan="2"/>
        <Label x:Name="f2eredmeny" Content="" HorizontalAlignment="Left" Margin="50,101,0,0" VerticalAlignment="Top" Grid.Row="1"/>
        <Button x:Name="f1" Content="Lekérés" HorizontalAlignment="Left" Margin="50,65,0,0" VerticalAlignment="Top" Width="51" Click="f1_Click" Grid.Row="1"/>
        <TextBox x:Name="szam" HorizontalAlignment="Left" Margin="221,32,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Grid.Row="1"/>
        <Label Content="Adja meg a nap sorszámát:" HorizontalAlignment="Left" Margin="49,28,0,0" VerticalAlignment="Top" Grid.Row="1"/>
        <Label Content="3. feladat" HorizontalAlignment="Left" Margin="49,139,0,0" Grid.Row="1" VerticalAlignment="Top" FontSize="16"/>
        <ListBox x:Name="f3" Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="49,175,580,26"/>
        <Button Content="Lekérés" HorizontalAlignment="Left" Margin="143,145,0,0" Grid.Row="1" VerticalAlignment="Top" Click="Button_Click"/>
        <Label Content="4. feladat" HorizontalAlignment="Center" Margin="0,138,0,0" Grid.Row="1" VerticalAlignment="Top" FontSize="16"/>
        <Button Content="Lekérés" HorizontalAlignment="Left" Margin="460,144,0,0" Grid.Row="1" VerticalAlignment="Top" Click="Button_Click_1"/>
        <ListBox x:Name="f4" Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="363,175,156,26"/>

    </Grid>
</Window>
